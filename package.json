{
  "name": "zn-crew-control-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "emulators": "firebase emulators:start --only firestore,auth --import=./emulator-data --export-on-exit=./emulator-data",
    "create-user": "node scripts/create-user.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && firebase deploy --only auth,firestore:rules,hosting",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "paid:dev-server": "tsx server.ts",
    "paid:build-server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "setup": "bash scripts/setup-firebase.sh"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "firebase": "^12.17.1",
    "firebase-admin": "^13.0.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "papaparse": "^5.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
