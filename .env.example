# =====================================================================
# FREE-TIER BUILD (default): only the VITE_* values below are used.
# Everything else in this file belongs to the optional paid backend
# (server.ts on Cloud Run) and is ignored by `npm run dev` / `npm run build`.
# NEVER put real secrets in this example file — it is committed to git.
# =====================================================================
# Use the local Firebase emulators in dev (set to "false" to hit live Firebase)
VITE_USE_FIREBASE_EMULATOR="true"
# Optional: URL of any AI backend that accepts POST {message, context} and
# returns {reply}. Leave empty to use the free Microsoft Copilot Chat handoff.
VITE_AI_BACKEND_URL=""

# ---------------- OPTIONAL PAID BACKEND (server.ts) ----------------
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# WHATSAPP BUSINESS API (Server-Side Secrets)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_API_ENDPOINT="https://graph.facebook.com/v20.0"
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET: Your Meta app's secret (App Dashboard → Settings → Basic).
# Used to verify that webhook POSTs genuinely came from Meta, not a forged request.
WHATSAPP_APP_SECRET=""

# EMAIL / SMTP SERVICE (Server-Side Secrets)
SMTP_HOST="smtp.mailgun.org"
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER_EMAIL="crewcontrol@zambiaairways.co.zm"
SMTP_SENDER_NAME="Zambia Airways Crew Operations Control"
SMTP_REPLY_TO="occ@zambiaairways.co.zm"

