
{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "server.cjs", "server.cjs.map"],
    "rewrites": [
      { "source": "/api/**", "run": { "serviceId": "za-crew-api", "region": "europe-west1" } },
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  },
  "firestore": { "database": "ai-studio-zambiaairwayscre-33b74f1d-975c-491a-96d7-ace7a8a76942", "rules": "firestore.rules" },
  "emulators": {
    "firestore": { "port": 8081 },
    "auth": { "port": 9099 },
    "ui": { "enabled": true, "port": 4001 },
    "singleProject": true
  }
}